                $('body').on('click', '.cls_closeBtn', function() {
                    $('.phoneError').hide();
                    $('.otpNumber').val('');
                    $('.phoneNumber').val('');
                    $('#fpUsername').val('');
                    $('#fpUsername').blur();
                    $('.input-group').removeClass('input-group--dirty');
                });
                var timer = 60;
                var intervalId = null;
                $('body').on('click', '.sendOtpBtn', function() {
                    sendOTP();
                });

                $('body').on('click', '.resendOtpBtn', function() {
                    sendOTP(true);
                });
                
                function sendOTP(resend = null){
                    $('.sendOtpBtn').html('Please wait ...').attr('disabled', 'disabled');
                    $('.otpNumber').val('');

                    var phone = $('.phoneNumber').val();
                    if (phone == '') {
                        $('.phoneError').css('display', 'block');
                        $('.sendOtpBtn').html('Send OTP').removeAttr('disabled');
                        return false;
                    } else {
                        let number_pattern = /^(0|91)?[6-9][0-9]{9}$/;
                        if (!phone.match(number_pattern)) {
                            notify('Invalid Phone Number', 'danger');
                            $('#signUpButton').removeAttr('disabled').html('__("SIGN UP")')
                            $('.sendOtpBtn').html('Send OTP').removeAttr('disabled');
                            return false;
                        }
                        $('.phoneError').css('display', 'none');
                        $('.sendOtpBtn').attr('disabled', 'disabled');
                        $.ajax({
                            type: "post",
                            url: 'https://playkaro365.com/api2/v2/sendLoginOtp',
                            data: {
                                'phone': phone,
                                '_token': '',
                                'resend':resend
                            },
                            success: function(data) {
                                $('.sendOtpBtn').html('Send OTP').removeAttr('disabled');

                                if (data.statusCode == 201) {

                                    notify(data.message, 'success')

                                    setTimeout(function() {
                                        $('.sendOtpBtn').html('Resend OTP').removeAttr('disabled');
                                        $('.resendOtpBtn').html('Resend OTP').removeAttr('disabled');
                                    }, 5000)

                                    timer = 60
                                    $('.login_otp_counter').html(timer);
                                    $('.mobile_otp_div').show();
                                    // $('.mobile_number_div').parents('.input-group--text-field').addClass('input-group--focused')
                                    $('.login_form_div, .horizontal_or, .social_login_div, .mobile_number_div ')
                                        .hide();

                                    $('.resend_otp_btn').hide()
                                    $('.login_otp_counter').parent().show()

                                    if (intervalId) {
                                        clearInterval(intervalId);
                                    }

                                    intervalId = setInterval(function() {
                                        timer = timer - 1;
                                        if (timer > 0) {
                                            $('.login_otp_counter').html(timer)
                                        } else {
                                            $('.resend_otp_btn').show()
                                            $('.login_otp_counter').parent().hide()
                                        }
                                    }, 1000)
                                }else if(data.statusCode == 403) {
                                    $('.sendOtpBtn').html('Send OTP').removeAttr('disabled');
                                    notify(data.message)
                                    forgot_password_inLoginModal();
                                } else {
                                    $('.sendOtpBtn').html('Send OTP').removeAttr('disabled');
                                    notify(data.message)
                                }
                            },
                            error: function(response) {
                                if (response.status == 419) {
                                    notify('Something went wrong');
                                } else if (response.status == 429) {
                                    notify('Something went wrong');
                                } else {
                                    notify('Something went wrong');
                                }
                            }
                        });

                    }
                }
                $('body').on('click', '.forgotPassword', function() {
                    $('.horizontal_or').removeAttr('style');
                });


                $('body').on('click', '.confirmOtp', function() {
                    var otp = $('.otpNumber').val();
                    var phone = $('.phoneNumber').val();
                    if (otp == '') {
                        // $('.otpErr').css('display', 'block');
                        notify('Please enter the OTP.','danger');
                        return false;
                    } else {
                        $('.sendOtpBtn').html('Send OTP').removeAttr('disabled');
                        timer = 0;
                        $('.confirmOtp').attr('disabled', 'disabled');
                        $('.otpErr').css('display', 'none');
                        $.ajax({
                            type: "post",
                            url: 'https://playkaro365.com/api2/v2/validateOtp',
                            data: {
                                'otp': otp,
                                'phone': phone,
                                '_token': ''
                            },
                            success: function(data) {
                                if (data.statusCode == 200) {
                                    location.reload();
                                }else if(data.statusCode == 403) {
                                    $('.confirmOtp').removeAttr('disabled');
                                    $('.otpNumber').val('')
                                    notify(data.message)
                                    forgot_password_inLoginModal();
                                } else {
                                    $('.confirmOtp').removeAttr('disabled');
                                    $('.otpNumber').val('')
                                    notify(data.message)
                                }
                            },
                            error: function(response) {
                                if (response.status == 419) {
                                    notify('Something went wrong');
                                } else if (response.status == 429) {
                                    notify('Something went wrong');
                                } else {
                                    notify('Something went wrong');
                                }
                            }
                        });

                    }
                });

                $('body').on('click', '#mob_otp', function() {
                    timer = 0;
                    $('.sendOtpBtn').html('Send OTP').removeAttr('disabled');

                    $('.mobile_number_div').show();
                    $('.login_form_div, .horizontal_or, .social_login_div, .mobile_otp_div ').hide();
